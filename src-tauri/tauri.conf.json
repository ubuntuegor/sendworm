{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sendworm",
  "version": "1.0.2",
  "identifier": "to.bnt.sendworm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Sendworm",
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 600,
        "backgroundColor": "#0e0e0b",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Send files securely using Magic Wormhole.",
    "targets": ["deb", "rpm", "appimage", "dmg", "nsis"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
