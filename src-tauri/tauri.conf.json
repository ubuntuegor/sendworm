{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sendworm",
  "version": "1.0.3",
  "identifier": "to.bnt.sendworm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sendworm",
        "width": 800,
        "height": 600,
        "minWidth": 400,
        "minHeight": 600,
        "backgroundColor": "#0e0e0b",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Send files securely using Magic Wormhole",
    "targets": ["deb", "rpm", "dmg", "nsis"],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/Sendworm.desktop.hbs",
        "depends": ["xdg-desktop-portal"],
        "files": {
          "/usr/share/metainfo/to.bnt.sendworm.metainfo.xml": "linux/to.bnt.sendworm.metainfo.xml"
        }
      },
      "rpm": {
        "desktopTemplate": "linux/Sendworm.desktop.hbs",
        "depends": ["xdg-desktop-portal"],
        "files": {
          "/usr/share/metainfo/to.bnt.sendworm.metainfo.xml": "linux/to.bnt.sendworm.metainfo.xml"
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
